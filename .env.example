# Website
NEXT_PUBLIC_SITE_URL=https://daily-absurd.vercel.app
SITE_URL=https://daily-absurd.vercel.app

# Newsletter plumbing (optional; site works without)
# GitHub PAT with repo scope, used by the Vercel function to dispatch
# subscriber events into this repo. Create one at github.com/settings/tokens.
NEWSLETTER_DISPATCH_TOKEN=
NEWSLETTER_REPO=Collinskib/daily-absurd
NEWSLETTER_SECRET=change-me

# Agent operations
ABSURD_STATE_DIR=           # defaults to agents/state
ABSURD_DEVIN_ENABLED=1      # 0 = research-only mode (no writer/editor sessions)
ABSURD_GIT_PUSH=1           # 0 = stage files locally without pushing
DEVIN_TIMEOUT_SECONDS=900
ABSURD_MAX_ARTICLES=4
ABSURD_MIN_IDEA_SCORE=6.5
ABSURD_MIN_COMEDY_SCORE=7.0
ABSURD_DASHBOARD_PORT=8899

# Traffic metrics (growth_analyst reads these toward the reader target)
ABSURD_READER_TARGET=10000                    # monthly visitors goal
# Optional: long-lived Vercel token (vercel.com/account/tokens). Without it
# the agents reuse your local `vercel` CLI auth automatically.
ABSURD_VERCEL_TOKEN=
# Google Search Console. Preferred: service-account JSON — the shared
# claude-seo credentials are the default; add the SA email as a user on
# the GSC property and only ABSURD_GSC_SITE is needed.
ABSURD_GSC_SITE=https://daily-absurd.vercel.app/
ABSURD_GSC_SA_PATH=~/.config/claude-seo/service_account.json
# Alternative auth: OAuth creds produced once by
#   cd agents && PYTHONPATH=. python3 -m absurd_ops.cli gsc-auth
ABSURD_GSC_CLIENT_ID=
ABSURD_GSC_CLIENT_SECRET=
ABSURD_GSC_REFRESH_TOKEN=
